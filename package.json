{
  "name": "plancake-discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "PlanCake — персональный Discord-планировщик на TypeScript",
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "stop": "taskkill /f /fi \"IMAGENAME eq node.exe\" /fi \"WINDOWTITLE eq npm*\""
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
